{
  "name": "finance-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted personal finance dashboard with automatic Israeli bank ingestion, rule-based categorization and analytics.",
  "scripts": {
    "dev": "next dev -H ${APP_BIND_IP:-127.0.0.1}",
    "build": "next build",
    "start": "next start -H ${APP_BIND_IP:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test src/lib/services/*.test.ts",
    "worker": "tsx src/lib/jobs/worker.ts",
    "sync:once": "tsx src/lib/jobs/worker.ts --once",
    "categorize:once": "tsx src/lib/jobs/categorize.ts",
    "riseup:fetch": "tsx scripts/riseup-fetch.ts",
    "riseup:compare": "tsx scripts/riseup-compare.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "key:keychain": "security add-generic-password -a \"$USER\" -s finance-dashboard.encryption-key -w \"$(openssl rand -hex 32)\" && echo 'New encryption key stored in macOS Keychain (service: finance-dashboard.encryption-key)'",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "israeli-bank-scrapers": "6.12.1",
    "lucide-react": "1.28.0",
    "next": "15.5.22",
    "next-intl": "4.13.6",
    "node-cron": "4.6.0",
    "pgsql-ast-parser": "12.0.2",
    "puppeteer": "24.43.1",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
