# ── Database ─────────────────────────────────────────────────────────────────
# Local development URL. Inside docker-compose the host is `db` (the compose
# file sets DATABASE_URL for the containers automatically). Use the same
# password as POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://finance:CHANGE_ME@localhost:5432/finance?schema=public

# ── Security ─────────────────────────────────────────────────────────────────
# 32-byte hex key used for AES-256-GCM encryption of stored bank credentials.
# Losing/rotating this key makes previously saved credentials undecryptable.
#
# The key is resolved from the first available source:
#   1. ENCRYPTION_KEY       — inline key (generate with: openssl rand -hex 32)
#   2. ENCRYPTION_KEY_FILE  — path to a file containing the key
#                             (Docker secrets / systemd LoadCredential on Linux)
#   3. macOS Keychain       — automatic fallback on Mac; store once with:
#                             npm run key:keychain
# Leave both variables empty on a Mac to use the Keychain.
ENCRYPTION_KEY=
#ENCRYPTION_KEY_FILE=/run/secrets/encryption_key

# ── Scheduling ───────────────────────────────────────────────────────────────
# Process time zone. Must stay Asia/Jerusalem: the bank scrapers parse provider
# dates in local time and the instants feed transaction ids (ADR-0020). The
# worker and ingestion pin it regardless; the 04:00 cron is Israel time.
TZ=Asia/Jerusalem

# ── Postgres container (docker-compose `db` service) ─────────────────────────
# POSTGRES_PASSWORD is REQUIRED: docker compose and scripts/run-host-worker.sh
# refuse to start without it (there is no default). Generate a URL-safe one:
#   openssl rand -hex 24
# Postgres applies it only when the data volume is first created; for an
# existing volume keep the password it was created with (or ALTER USER first).
POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_DB=finance

# ── Isracard browser compatibility ──────────────────────────────────────────
# Optional path to a locally installed Chrome/Edge executable. Use this when
# Isracard's WAF rejects bundled/headless Chromium. In Docker, the host's Mac
# browser cannot be mounted into the Linux container; run the worker on the
# host or provide a compatible browser binary inside the container instead.
#ISRACARD_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#ISRACARD_SHOW_BROWSER=false
# Persistent real-Chrome profile used to pass Cloudflare (default: ~/.finance-dashboard/isracard-chrome-profile)
#ISRACARD_USER_DATA_DIR=
# Set to true only on a host whose profile already passed the challenge
#ISRACARD_HEADLESS=false

# ── Optional LLM categorization via Kiro CLI ─────────────────────────────────
# Runs after deterministic rules and only touches still-uncategorized rows.
# Requires kiro-cli to be installed and logged in for the OS user running the
# worker. Each batch consumes Kiro credits and sends redacted transaction
# descriptions to the selected Kiro model. Disabled by default.
# LLM categorization of transactions left unassigned by rules. Runs from the host
# sync (npm run sync:once / categorize:once), never from POST /api/sync.
LLM_CATEGORIZATION_ENABLED=false
# Which headless CLI performs the classification: kiro (default) or hermes.
# hermes = Hermes Agent (hermes-agent.nousresearch.com) using the provider you
# logged in with there (e.g. OpenAI). Redacted merchant descriptions are sent to
# that provider.
#CATEGORIZATION_CLI=hermes
#CATEGORIZATION_CLI_PATH=/absolute/path/to/hermes-or-kiro-cli
#HERMES_CATEGORIZATION_MODEL=gpt-5.5
# Legacy alias of LLM_CATEGORIZATION_ENABLED (still honoured)
KIRO_CATEGORIZATION_ENABLED=false
KIRO_CATEGORIZATION_MODEL=gpt-5.6-sol
KIRO_CATEGORIZATION_AGENT=finance-categorizer
KIRO_CATEGORIZATION_BATCH_SIZE=100
KIRO_CATEGORIZATION_TIMEOUT_MS=180000
#KIRO_CLI_PATH=/absolute/path/to/kiro-cli
# ── Network binding (the ONLY access control — there is no auth layer) ──────
# Interface for `npm start` / `npm run dev` (-H) and the docker-compose app
# publish. Default 127.0.0.1 = this machine only. To use the app from your
# phone, set this to the host's Tailscale IP (`tailscale ip -4`, 100.x.y.z).
# Never 0.0.0.0 or a LAN address.
#APP_BIND_IP=127.0.0.1

# ── API request guard (CSRF / DNS rebinding, ADR-0019) ───────────────────────
# Comma-separated origins the UI is served from besides localhost/127.0.0.1,
# e.g. the Tailscale address used from a phone. Requests to /api/*
# with any other Host header, and cross-site mutations, get a 403.
#APP_ORIGIN=http://100.64.0.10:3002   (match APP_BIND_IP; never a LAN address)

# ── Free-text chat (/chat, ADR-0026) — OFF by default ───────────────────────
# Questions and the data the assistant looks up (redacted descriptions, amounts,
# balances) are sent to the model provider configured in Hermes (or Kiro).
# The model has no host tools; the server runs every lookup read-only.
CHAT_ENABLED=false
# Required when enabled: the SELECT-only role created by
# scripts/setup-chat-readonly-role.sql (never the read-write DATABASE_URL).
#CHAT_DB_URL=postgresql://finance_chat_ro:<password>@localhost:5432/finance
# hermes (default) | kiro
#CHAT_CLI=hermes
#CHAT_CLI_PATH=/absolute/path/to/hermes
#HERMES_CHAT_MODEL=gpt-5.5
#KIRO_CHAT_MODEL=gpt-5.6-sol
#CHAT_MAX_ROUNDS=4
#CHAT_TIMEOUT_MS=120000
#CHAT_RATE_LIMIT_PER_MINUTE=6
